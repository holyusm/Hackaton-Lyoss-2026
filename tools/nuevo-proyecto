#!/usr/bin/env bash
# Prepara un repo recién creado desde el template holyusm/hackaton-kit:
#   1. crea y fija el issue "Message Board" (el tablero; en un repo nuevo es el #1)
#   2. invita a los compañeros con permiso de escritura
#   3. marca esta copia local como sesión orquestadora (.board/role)
# Uso (dentro del clon del repo nuevo):  tools/nuevo-proyecto [--sin-invitar]
# Se puede correr de nuevo sin problema: no duplica el tablero ni las invitaciones.
set -euo pipefail

TEAM=(Gxppe juaquo15)
INVITAR=1
for a in "$@"; do
  case "$a" in
    --sin-invitar) INVITAR=0 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "Opción desconocida: $a" >&2; exit 2 ;;
  esac
done

die() { echo "ERROR: $*" >&2; exit 1; }
command -v gh >/dev/null || die "falta gh (GitHub CLI)"
gh auth status >/dev/null 2>&1 || die "corre primero: gh auth login"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "corre esto dentro del clon del repo nuevo"
cd "$ROOT"
REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" || die "no encuentro el repo en GitHub (¿falta el remote?)"
[ "$REPO" != "holyusm/hackaton-kit" ] || die "estás en el kit. Crea primero el repo del proyecto desde el template"
echo "Repo: $REPO"

# 1. Tablero
gh label create board --color 5319e7 --description "Tablero del equipo" --force >/dev/null
N="$(gh issue list --label board --state all --json number --jq 'map(.number) | min // empty')"
if [ -z "$N" ]; then
  BODY="$(awk 'BEGIN{f=0} /^---$/ && f<2 {f++; next} f>=2' .github/ISSUE_TEMPLATE/message-board.md)"
  URL="$(gh issue create --title "Message Board" --label board --body "$BODY")"
  N="${URL##*/}"
  echo "Tablero creado: issue #$N"
else
  echo "Tablero ya existía: issue #$N"
fi
gh issue pin "$N" >/dev/null 2>&1 || true
if [ "$N" != "1" ]; then
  echo "AVISO: el tablero es el issue #$N, no el #1. Todos deben hacer: export BOARD_ISSUE=$N"
fi

# 2. Compañeros
if [ "$INVITAR" = 1 ]; then
  for u in "${TEAM[@]}"; do
    if gh api -X PUT "repos/$REPO/collaborators/$u" -f permission=push >/dev/null; then
      echo "Invitado: @$u (debe aceptar en https://github.com/$REPO/invitations)"
    else
      echo "No pude invitar a @$u; hazlo en Settings > Collaborators" >&2
    fi
  done
else
  echo "Invitaciones omitidas (--sin-invitar)"
fi

# 3. Rol orquestador en esta copia (gitignored)
mkdir -p .board
echo orquestador > .board/role
echo "Esta copia queda como ORQUESTADOR (.board/role)."

cat <<EOF

Listo. Siguientes pasos:
  - Compañeros: aceptar la invitación y luego  gh repo clone $REPO
  - Reabre Claude Code en esta carpeta para que tome el rol de orquestador.
  - Prueba el tablero:  tools/board whoami  &&  tools/board read -n 5
EOF
